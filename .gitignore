# eval — the dataset is fetched by `npm run fetch`, not committed.
# dataset.csv (source URL, licence, photographer) IS committed so the set
# stays reproducible; the images themselves are not.
eval/photos/
eval/dataset.full.csv

# eval — generated run artefacts. The curated results-*.md reports are
# committed; raw dumps and console logs are not.
eval/results-raw.json
eval/*.log

